# Optional Shopify Storefront API configuration (public Storefront token only).
# Create a Storefront API access token in Shopify. Never put an Admin API token here.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token
VITE_SHOPIFY_API_VERSION=2025-01
